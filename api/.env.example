POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=orderdb
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgres://app:@localhost:5432/orderdb?sslmode=disable

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=
JWT_EXPIRY=24h

PORT=8080

# Listener terpisah untuk /metrics; tidak di-expose keluar compose.
METRICS_PORT=9100
PROMETHEUS_PORT=9090
# 3000 sering dipakai dev server lain, jadi default-nya 3001.
GRAFANA_PORT=3001

GO_ENV=development

# URL harus lengkap: scheme + host:port + path /v1/traces.
# Hostname "jaeger" hanya resolve di dalam network compose; untuk dev di luar docker pakai localhost.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=order-api
OTEL_SAMPLE_RATIO=1.0
